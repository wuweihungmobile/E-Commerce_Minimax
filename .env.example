# =============================================
# E-Commerce Platform - Environment Variables
# 複製為 .env 後填入實際值
# 重要：.env 檔案不應提交到 Git
# =============================================

# ---- 環境一致性 ----
# 設為 linux/arm64 可在 M1/M2 Mac 上原生運行（更快速）
# 設為 linux/amd64 模擬正式環境
DOCKER_PLATFORM=linux/amd64
SPRING_PROFILES_ACTIVE=prod

# ---- 前端 ----
# 瀏覽器端呼叫後端用的基底網址（建置時內嵌）。⚠️ 不可含 /v2：前端每個 API 路徑自己就以 /v2/ 開頭（src/lib/api.ts），
# 多寫一段會變成 /api/v2/v2/…，後端回 E-1000，登入、註冊全部失敗（DEF-355／DEF-490，Sprint 337 改正）。
# 既有的 .env 若是用舊版 .env.example 複製的（make setup 只在 .env 不存在時才建立），請手動把這一行改成不含 /v2。
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# 伺服器端（Next 的 Server Component／generateMetadata）呼叫後端公開 API 用的基底網址（DEF-475，Sprint 335）。
# 沒有 NEXT_PUBLIC_ 前綴＝只存在於伺服器。前端與後端在不同容器／主機時要設成伺服器看得到的後端位址。
# 取不到時（沒設、連不上、逾時）公開頁的標題退回靜態的頁型標題（「店鋪首頁」「商品／房源詳情」），頁面照常顯示。
# docker-compose.yml（正式與 CI 模擬）預設 http://backend:8080/api——同一個 compose 網路的後端服務（Sprint 337，使用者明確指示）；
# 開發用的 docker-compose.override.yml 設為 http://ecommerce-backend-dev:8080/api（Sprint 336，合併時以 override 為準，不受 .env 影響）；
# 不走 compose（例如 npm run dev 直連本機後端）時程式預設 http://localhost:8080/api。要覆寫正式／CI 模擬的值才取消下一行的註解。
# API_INTERNAL_URL=http://backend:8080/api
# 正式站的公開網域：Open Graph 的網址與圖片需要絕對網址（根 layout 的 metadataBase）。預設 https://www.nextkey.com。
# NEXT_PUBLIC_SITE_URL=https://www.nextkey.com

# ---- 後端 JWT ----
# 生成方式：openssl rand -base64 64（make setup 建立 .env 時會自動產生一組）
# 必須至少 256 bits (32 bytes) 以支援 HS256
# ⚠️ 下面這個佔位值不可原樣使用：含 "change-in-production" 的值，後端一律拒絕啟動（DEF-251／DEF-320）
JWT_SECRET=your-256-bit-secret-key-please-change-in-production-min-32-chars

# ---- PostgreSQL ----
POSTGRES_USER=koala
POSTGRES_PASSWORD=koala5
POSTGRES_DB=nextkeytest

# ---- Redis（必須與後端 SPRING_DATA_REDIS_PASSWORD 一致）----
REDIS_PASSWORD=redis-dev-password

# ---- 寄信（Google Workspace SMTP）----
# SMTP_USERNAME 留空＝不啟用真實寄信（日誌型，不寄出）。啟用前請先完成 DEF-347（寄信改非同步）。
# SMTP_PASSWORD 必須是應用程式密碼（App Password），不是登入密碼。
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 寄件位址；留空時沿用 SMTP_USERNAME
SMTP_FROM_ADDRESS=

# ---- 前端網址、CORS 與排程 ----
# 重設密碼與 Email 驗證連結的網域；非 localhost 部署必須設定
APP_FRONTEND_BASE_URL=http://localhost:3000
# 逗號分隔；不可用 *（後端 allowCredentials=true）
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# 反向代理層數——全專案唯一與「前面有沒有代理」有關的設定（Sprint 341，DEF-501／DEF-487）：
# 訪客的請求抵達後端之前，要經過幾層反向代理／負載平衡器／CDN？
#   0 ＝ 沒有（預設，與現況相同，docker-compose.yml 沒有 nginx／traefik）
#   1 ＝ 一層（nginx、Traefik、Caddy、AWS ALB、雲端負載平衡器）
#   2 ＝ 兩層（例如 Cloudflare ＋ nginx）；上限 10
# 為什麼要設：後端依「來源 IP」限流（匿名每分鐘 100 次、登入／註冊每分鐘 30 次）。前面有代理卻沒設，
# 所有訪客看起來都來自代理，共用同一個限流桶，正常使用者互相擋。設了之後前端伺服器代訪客呼叫後端時也會歸到訪客自己的桶。
# 設成 1 以上的前提（否則反而讓人可以偽造 IP 繞過限流）：
#   ① 代理用「附加」方式寫 X-Forwarded-For（nginx：proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for；
#      Traefik、Caddy、AWS ALB、Cloudflare 預設就是）
#   ② 後端 8080 與前端 3000 不對外開放，只有代理能連到它們
# TLS 在哪終止不必設定：代理送 X-Forwarded-Proto: https，前後端就會送 HSTS。
# 有代理後，上方的 NEXT_PUBLIC_API_URL、APP_FRONTEND_BASE_URL、APP_CORS_ALLOWED_ORIGINS 也要改成對外網址（例如 https://www.example.com/api）。
APP_TRUSTED_PROXY_HOPS=0
# 排程總開關；設為 false 會同時停止自動退款與逾時取消（緊急時使用）
APP_SCHEDULING_ENABLED=true
# no-show 自動取消總開關（DEF-352）；開啟前須先人工驗證店家能透過入住按鈕正常入住（DEF-350）
BOOKING_NO_SHOW_AUTO_CANCEL_ENABLED=false

# ---- CI 專用（GitHub Actions Secrets 注入）----
# 正式部署時從 secrets manager 注入
# CI_REDIS_PASSWORD=ci-redis-password
# CI_JWT_SECRET=ci-jwt-secret
