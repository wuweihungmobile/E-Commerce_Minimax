#!/usr/bin/env sh
# 🔴 AISDLC v0.09: Backend Pre-commit Hook (強化版)
# 自動執行 Checkstyle + Maven 編譯 + 核心層單元測試
# 跳過方式：git commit --no-verify
# 安裝方式：scripts/install-hooks.sh
# =============================================

# 取得 staged 變更檔案
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(java|xml|sql|yml|yaml|properties)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "ℹ️  No staged backend files, skipping pre-commit checks"
  exit 0
fi

echo "🔍 Backend pre-commit checks for staged files:"
echo "$STAGED_FILES" | sed 's/^/  - /'
echo ""

# 1. Checkstyle 檢查（快速）
echo "📝 [1/3] Running Checkstyle (Backend)..."
cd backend && mvn checkstyle:check -q
CHECKSTYLE_EXIT=$?
cd ..

if [ $CHECKSTYLE_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Checkstyle failed (exit code: $CHECKSTYLE_EXIT)"
  echo "   Please fix code style issues before committing."
  echo "   Skip with: git commit --no-verify"
  exit $CHECKSTYLE_EXIT
fi

echo "✅ Checkstyle passed"
echo ""

# 2. Maven 編譯檢查
echo "🔨 [2/3] Running Maven compile (Backend)..."
cd backend && mvn compile -DskipTests -q
COMPILE_EXIT=$?
cd ..

if [ $COMPILE_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Maven compile failed (exit code: $COMPILE_EXIT)"
  echo "   Please fix compilation errors before committing."
  echo "   Skip with: git commit --no-verify"
  exit $COMPILE_EXIT
fi

echo "✅ Maven compile passed"
echo ""

# 3. Maven 單元測試（核心層）
echo "🧪 [3/3] Running Maven quick test (core layer only)..."
# 🔴 排除 E2E 測試（需要真實 HTTP/DB，留給 CI Integration 階段）
cd backend && mvn test -Dtest="com.nextkey.ecommerce.core.**,!com.nextkey.ecommerce.core.**.*E2E" -Dspring.profiles.active=test -q
TEST_EXIT=$?
cd ..

if [ $TEST_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Maven quick test failed (exit code: $TEST_EXIT)"
  echo "   Please fix test failures before committing."
  echo "   Skip with: git commit --no-verify"
  exit $TEST_EXIT
fi

echo "✅ Maven quick test passed (core layer)"
echo ""
echo "🎉 All backend pre-commit checks passed!"
