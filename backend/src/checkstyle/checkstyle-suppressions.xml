<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle Suppressions for NextKey E-Commerce Project
  用於抑制無法修復的 checkstyle 錯誤模式

  這些模式是 Java 語法限制，無法透過去除 final 關鍵字修復：
  1. Lambda 表達式參數 - Java 不允許在 lambda 參數上加 final
  2. Catch 區塊變數 - Java 不允許在 catch 的異常參數上加 final
  3. 匿名內部類別建構子參數 - Java 不允許在這些位置加 final
-->

<module name="Checker">
  <property name="severity" value="error"/>

  <module name="SuppressionFilter">
    <property name="optional" value="true"/>
  </module>

  <!-- 抑制 FinalParameters 檢查 -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="FinalParameters"/>
    <property name="files" value=".*"/>
  </module>

</module>
