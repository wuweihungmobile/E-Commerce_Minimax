<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle configuration for test source files only.
  Only enforces UnusedImports to avoid false positives from test-specific patterns
  (star imports like org.hamcrest.Matchers.*, SpringBoot annotations, etc.).
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <module name="UnusedImports"/>
  </module>

</module>
