#!/usr/bin/env sh
# =============================================
# AISDLC v0.09: Commit-Msg Hook（精簡版 v3）
# 目的：基本 commit message 檢查
#
# 🔴 v3 變更（2026-06-23）：
#   - 移除 CI 驗證記錄強制檢查
#   - 原因：完整 act CI 驗證已移到 pre-push（「上去 GIT」這道門才強制 act）
#     commit 是本機操作，不需要在每個 commit 強制 CI 記錄
#   - 真正的防線在 pre-push：推送前批次跑一次 act，沒通過就擋下
#
# 注意：commit-msg 在 pre-commit 成功後才執行（pre-commit 失敗則 commit 被拒絕，不會到達這裡），
#       但它不再是 CI 驗證關卡，僅做訊息格式檢查。
# =============================================

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR" || exit 1

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null | tr -d '\n' | head -c 200)

# 1. 防止空 commit message
if [ -z "$COMMIT_MSG" ]; then
    echo "🔴 ERROR: 空的 commit message"
    exit 1
fi

exit 0
