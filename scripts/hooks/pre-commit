#!/usr/bin/env sh
# =============================================
# AISDLC v0.09: Root Pre-commit Hook（快速版 v3）
# 自動依 staged 檔案類型，呼叫對應的 backend/frontend hook
#
# 🔴 v3 變更（2026-06-23）：
#   - 移除 commit 時的完整 act CI 驗證（過去每次 commit 都要 5-10 分鐘）
#   - commit 階段只做「快速檢查」（lint + compile + 變動模組測試 + secret 掃描）
#   - 完整 act CI 驗證移到 pre-push（「上去 GIT」這道門才是真正的關卡）
#
# 為什麼這樣安全？
#   - commit 是本機操作，不會上 GitHub
#   - pre-push 會在推送前批次跑一次完整 act，沒通過就擋下
#   - 「沒驗證就上去 GIT」的保證完全不變，只是 act 不再每次 commit 重跑
# =============================================

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# 取得所有 staged 檔案
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

HAS_BACKEND=$(echo "$STAGED_FILES" | grep -E '^backend/' | head -1 || true)
HAS_FRONTEND=$(echo "$STAGED_FILES" | grep -E '^frontend/' | head -1 || true)

EXIT_CODE=0

echo "=========================================="
echo "🔍 Pre-commit 快速檢查（lint + compile + 核心測試）"
echo "   （完整 act CI 驗證將在 push 前執行）"
echo "=========================================="

# 1. Backend 快速檢查
if [ -n "$HAS_BACKEND" ] && [ -x "$ROOT_DIR/backend/hooks/pre-commit" ]; then
  echo "🚀 Running backend pre-commit checks..."
  echo "=========================================="
  if ! "$ROOT_DIR/backend/hooks/pre-commit"; then
    echo "❌ Backend pre-commit failed"
    EXIT_CODE=1
  fi
  echo ""
fi

# 2. Frontend 快速檢查
if [ -n "$HAS_FRONTEND" ]; then
  echo "🚀 Running frontend pre-commit checks..."
  echo "=========================================="
  cd "$ROOT_DIR/frontend"
  if [ -x "$ROOT_DIR/frontend/.husky/pre-commit" ]; then
    if ! "$ROOT_DIR/frontend/.husky/pre-commit"; then
      echo "❌ Frontend pre-commit failed"
      EXIT_CODE=1
    fi
  else
    echo "⚠️  Frontend husky not installed, running npm run lint + type-check directly..."
    if ! npm run lint || ! npm run type-check; then
      echo "❌ Frontend pre-commit failed"
      EXIT_CODE=1
    fi
  fi
  cd "$ROOT_DIR"
  echo ""
fi

# 3. Secret detection（輕量版）
echo "🔐 Checking for potential secrets in staged files..."
# 只比對「keyword 緊接 =/: 再接引號值」的真實賦值（如 password="xxx"、apiKey: "yyy"）；
# 收緊自舊版 `.*=.*"..."`（會誤中 keyword 為屬性值的表單標籤，如
# <label htmlFor="password" className="...">）。真實硬編機密仍會被攔截。
#
# 🔴 Sprint 110 變更：掃描對象由「整個 staged 檔案」改為「staged diff 的新增行」。
#    舊版用 `grep -l` 做檔案級比對，只要檔案裡任何一處命中就整檔擋下，連本次
#    一個字都沒改的既有內容也算。docs/01_requirements/E-Commerce_FRD_v1.0.md 自
#    初始 commit 後從未被修改，其 M03 章節的示例 payload（"password": "SecurePass123"）
#    因此從沒被掃到；Sprint 110 為了別的理由動到該檔，就被自己的既有內容擋下。
#    改為只看新增行後：「本次引入的機密」照樣攔截（偵測強度不降，反而定位更準），
#    「既有內容」不會因為碰了同一個檔案而被翻出來。
#    🔴 不要改回檔案級比對——那會讓每一次修改含示例憑證的規格文件都被誤擋。
SECRET_PATTERNS='(password|secret|api[_-]?key|access[_-]?token|private[_-]?key)[\"'\'']?[[:space:]]*[:=][[:space:]]*[\"'\''][^\"'\'']+[\"'\'']'
SECRET_EXCLUDES='\.example$|node_modules/|target/|\.class$|test/|Test\.java|testSecret|TestSecret|\.github/workflows/|scripts/hooks/|e2e/|\.spec\.ts|\.test\.ts'
SECRET_HITS=""
if [ -n "$STAGED_FILES" ]; then
  SCAN_FILES=$(echo "$STAGED_FILES" | grep -vE "$SECRET_EXCLUDES" || true)
  for SECRET_FILE in $SCAN_FILES; do
    FILE_HITS=$(git diff --cached -U0 -- "$SECRET_FILE" 2>/dev/null \
                  | grep -E '^\+' | grep -v '^+++' \
                  | grep -Ei "$SECRET_PATTERNS" || true)
    if [ -n "$FILE_HITS" ]; then
      SECRET_HITS="${SECRET_HITS}  ${SECRET_FILE}
$(echo "$FILE_HITS" | sed 's/^/      /')
"
    fi
  done
fi
if [ -n "$SECRET_HITS" ]; then
  echo "🔴 ERROR: Potential secrets detected in newly added lines:"
  echo "$SECRET_HITS"
  echo "⚠️  真實機密資訊不應被 commit。若為測試資料，請使用虛構值。"
  echo "🔴 拒絕 commit！請先移除機密資訊。"
  echo ""
  EXIT_CODE=1
fi

# 4. XML 非 BMP 字元檢查（S104 事故防呆）
# 本機 Maven 的 XML 解析器吞得下 U+1F534 等 BMP 以外字元，act 容器裡以 apt 安裝的
# Maven 吞不下，會在第一個 job 就以下列錯誤失敗，且本機全綠時完全看不出來：
#   Non-parseable POM: Illegal character 0xd83d found in comment
# 0xd83d 是 emoji 的 UTF-16 高位代理。CLAUDE.md 鼓勵用 🔴 標記，但該慣例不適用
# 於 XML（workflow YAML 不受影響）。d444b2d 與 Sprint 104 各踩過一次。
# 只擋 BMP 以外字元——中文註解在 BMP 內，合法。
STAGED_XML=$(echo "$STAGED_FILES" | grep -E '\.(xml|pom)$' || true)
if [ -n "$STAGED_XML" ]; then
  echo "📄 Checking XML files for non-BMP characters..."
  if ! echo "$STAGED_XML" | xargs python3 -c '
import sys
bad = []
for f in sys.argv[1:]:
    try:
        lines = open(f, encoding="utf-8").read().splitlines()
    except (OSError, UnicodeDecodeError):
        continue
    for i, line in enumerate(lines, 1):
        for c in line:
            if ord(c) > 0xFFFF:
                bad.append((f, i, c, line.strip()[:60]))
                break
if bad:
    print("🔴 ERROR: XML 含非 BMP 字元，CI 容器的 Maven 會拒收：")
    for f, i, c, l in bad:
        print(f"   {f}:{i}  {c} (U+{ord(c):04X})  | {l}")
    print("")
    print("⚠️  請改用純文字標記（🔴 慣例不適用於 XML）。本機 mvn 通過不代表 CI 會過。")
    sys.exit(1)
'; then
    EXIT_CODE=1
  fi
  echo ""
fi

echo ""
echo "=========================================="
if [ $EXIT_CODE -eq 0 ]; then
    echo "✅ 快速檢查通過！"
    echo "📌 提醒：完整 act CI 驗證會在 'git push' 前自動執行。"
    echo "   想提早跑完整驗證可執行：make validate-all"
    echo "=========================================="
    exit 0
fi

echo "🔴 快速檢查失敗！禁止 commit！"
echo "   請查看上方錯誤訊息並修復。"
echo "🔴 禁止使用 --no-verify！"
echo "=========================================="
exit 1
