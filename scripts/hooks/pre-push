#!/usr/bin/env sh
# =============================================
# AISDLC v0.09: Pre-Push Hook（嚴格版）
# 目的：確保 push 前已執行本地 CI 驗證
# 若無驗證記錄，直接執行 act 完整驗證
# 跳過方式：git push --no-verify（⚠️ 不建議，會導致 CI 失敗）
# 安裝方式：scripts/install-hooks.sh
# =============================================

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "=========================================="
echo "🔒 Pre-Push CI 驗證檢查"
echo "=========================================="

# 🔴 CRITICAL: 檢查 .ci-validated 是否被錯誤地 commit 到 Git
# 如果這個檔案被 commit，CI 會失敗
if git ls-files --error-unmatch .ci-validated &>/dev/null; then
    echo ""
    echo "🔴 ERROR: .ci-validated 已被 commit 到 Git！"
    echo ""
    echo "   這個檔案是本地驗證記錄，不應該被 commit。"
    echo "   它應該在 .gitignore 中。"
    echo ""
    echo "   請執行以下命令修復："
    echo "   git rm --cached .ci-validated"
    echo "   git commit -m 'chore: remove .ci-validated from git tracking'"
    echo ""
    echo "   然後重新 push。"
    echo ""
    exit 1
fi

# 取得目前 commit hash
CURRENT_COMMIT=$(git rev-parse HEAD)
CI_VALIDATED_FILE="$ROOT_DIR/.ci-validated"

# 檢查是否已有針對此 commit 的驗證
if [ -f "$CI_VALIDATED_FILE" ]; then
    VALIDATED_COMMIT=$(cat "$CI_VALIDATED_FILE" 2>/dev/null | head -1)
    VALIDATED_TIME=$(cat "$CI_VALIDATED_FILE" 2>/dev/null | tail -1)

    if [ "$VALIDATED_COMMIT" = "$CURRENT_COMMIT" ]; then
        echo "✅ CI 驗證記錄：已驗證 commit $VALIDATED_COMMIT"
        echo "📅 驗證時間：$VALIDATED_TIME"
        echo ""
        echo "允許 push ✅"
        exit 0
    fi
fi

echo ""
echo "⚠️  無有效 CI 驗證記錄"
echo "   目前 commit：$CURRENT_COMMIT"
echo ""
echo "=========================================="
echo "🔴 開始執行本地 CI 驗證..."
echo "=========================================="
echo ""

# 檢查 act 是否可用
if ! command -v act &> /dev/null; then
    echo "❌ 錯誤：找不到 'act' 命令"
    echo ""
    echo "📦 請先安裝 act："
    echo "   macOS: brew install act"
    echo "   Linux: curl -s https://raw.githubusercontent.com/nektos/act/master/install.sh | sh"
    echo ""
    echo "⚠️  若暫時無法安裝，可使用替代方案："
    echo "   cd backend && mvn verify -Dspring.profiles.active=integration-test"
    echo ""
    exit 1
fi

# 執行 act 完整 CI 驗證
cd "$ROOT_DIR"
if act -W .github/workflows/act-compat.yml; then
    # 驗證成功，創建標記檔案
    VALIDATED_TIME=$(date '+%Y-%m-%d %H:%M:%S')
    echo "$CURRENT_COMMIT" > "$CI_VALIDATED_FILE"
    echo "$VALIDATED_TIME" >> "$CI_VALIDATED_FILE"

    echo ""
    echo "=========================================="
    echo "✅ CI 驗證通過！已記錄驗證結果"
    echo "📅 驗證時間：$VALIDATED_TIME"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "🔴 CI 驗證失敗！禁止 push！"
    echo "=========================================="
    echo ""
    echo "❌ 錯誤：本地 CI 驗證未通過"
    echo ""
    echo "📋 請修復問題後重新執行驗證："
    echo "   act -W .github/workflows/act-compat.yml"
    echo ""
    echo "⚠️  提示："
    echo "   - 詳細錯誤訊息請查看上方日誌"
    echo "   - 若要跳過驗證（不建議），使用：git push --no-verify"
    echo ""
    exit 1
fi