#!/usr/bin/env sh
# =============================================
# AISDLC v0.09: Pre-Push Hook（嚴格門 v5 — 上 GIT = 完整測試程序）
# 目的：push 是「上 GIT」的唯一嚴格守門；每次 push 都要跑「完整測試程序」
#       = make validate-release（act backend+frontend + schema 漂移 + e2e，等價雲端 ci.yml）。
#
# 🔴 v5 變更（2026-06-30，使用者要求「批次 push 但上 GIT 必須做完整測試程序」）：
#   - pre-push 不再只跑 host 快檢；改為執行完整測試程序 make validate-release（~30-45 分）。
#   - 因為 push 已改為「低頻批次」（commit 勤、push 少），完整成本攤平、只在檢查點付一次。
#   - 完整驗證記錄帶 FULL 標記，只有 make validate-release 寫得出
#     → host 快檢（check-backend/frontend）不會誤放行 push。
#   - tree-hash 相符且 30 分內的 FULL 記錄 → 直接放行（避免手動 validate-release 後 push 又重跑一次）。
#   - 純文件/設定（無 backend/frontend 程式碼變動）→ 略過（完整測試對其無意義）。
#
# 分層：
#   pre-commit            ：lint + compile + 核心測試（快速，每次 commit）
#   pre-push（本檔）       ：完整測試程序 = make validate-release（~30-45 分，每次 push）
#   make validate-release ：可先手動跑一次（寫 FULL 記錄）→ 隨後 git push 30 分內直接放行
#
# 跳過方式：git push --no-verify（⚠️ 嚴禁！會導致未完整驗證程式碼上庫）
# =============================================

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# 跨平台 sha256：優先 sha256sum（Linux），fallback shasum -a 256（macOS）
calc_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
    else
        shasum -a 256 | cut -d' ' -f1
    fi
}

# FULL 記錄有效期：30 分（tree-hash 相符為主、時間為輔；完整測試程序本身約 30-45 分）
FULL_WINDOW_SECONDS=1800

echo "=========================================="
echo "🔒 Pre-Push 完整守門（上 GIT = 完整測試程序）"
echo "=========================================="

# 🔴 檢查 .ci-validation-data 是否被錯誤地 commit 到 Git
if git ls-files --error-unmatch .ci-validation-data >/dev/null 2>&1; then
    echo ""
    echo "🔴 ERROR: .ci-validation-data 已被 commit 到 Git！"
    echo "   這個目錄是本地驗證記錄，不應該被 commit（應在 .gitignore 中）。"
    echo "   修復："
    echo "   git rm -r --cached .ci-validation-data"
    echo "   git commit -m 'chore: remove .ci-validation-data from git tracking'"
    echo ""
    exit 1
fi

CURRENT_COMMIT=$(git rev-parse HEAD)
CI_DATA_DIR="$ROOT_DIR/.ci-validation-data"
CI_RECORD="$CI_DATA_DIR/commits"
CURRENT_TREE_HASH=$(git ls-tree -r HEAD 2>/dev/null | calc_sha256)
if [ -z "$CURRENT_TREE_HASH" ]; then
    CURRENT_TREE_HASH="empty"
fi

# 寫入 FULL 驗證記錄並放行（5 欄位：COMMIT|TIME|TREE|SUCCESS|FULL）
record_full_and_allow() {
    VALIDATED_TIME=$(date '+%Y-%m-%d %H:%M:%S')
    mkdir -p "$CI_DATA_DIR"
    if [ -f "$CI_RECORD" ]; then
        TMPRECORD=$(mktemp)
        grep -v "^$CURRENT_COMMIT|" "$CI_RECORD" > "$TMPRECORD" 2>/dev/null || true
        mv "$TMPRECORD" "$CI_RECORD"
    fi
    echo "$CURRENT_COMMIT|$VALIDATED_TIME|$CURRENT_TREE_HASH|SUCCESS|FULL" >> "$CI_RECORD"
}

# =============================================
# 1. 變動範圍：純文件/設定（無 backend/frontend 程式碼）→ 略過完整測試
# =============================================
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
REMOTE_HEAD=$(git rev-parse "origin/$CURRENT_BRANCH" 2>/dev/null || echo "")
if [ -n "$REMOTE_HEAD" ]; then
    CHANGED_FILES=$(git diff --name-only "$REMOTE_HEAD..HEAD" 2>/dev/null || echo "")
else
    CHANGED_FILES=""
fi
HAS_BE=$(echo "$CHANGED_FILES" | grep -E '^backend/' | head -1 || true)
HAS_FE=$(echo "$CHANGED_FILES" | grep -E '^frontend/' | head -1 || true)

if [ -n "$REMOTE_HEAD" ] && [ -z "$HAS_BE" ] && [ -z "$HAS_FE" ]; then
    echo "ℹ️  本次推送無 backend/frontend 程式碼變動（純文件/設定），完整測試對其無意義 → 允許 push ✅"
    exit 0
fi

# =============================================
# 2. 已有有效 FULL 驗證記錄（tree-hash 相符 + 30 分內）→ 直接放行
#    涵蓋情境：剛手動跑過 make validate-release，或前次 push 失敗後重試。
#    只認 FULL（完整測試程序）記錄；host 快檢不會寫 FULL，故無法誤放行。
# =============================================
if [ -f "$CI_RECORD" ]; then
    VALIDATED=$(grep "^$CURRENT_COMMIT|" "$CI_RECORD" 2>/dev/null | grep '|FULL$' | tail -1)
    if [ -n "$VALIDATED" ]; then
        VALIDATED_TIME=$(echo "$VALIDATED" | cut -d'|' -f2)
        RECORDED_TREE_HASH=$(echo "$VALIDATED" | cut -d'|' -f3)
        if date -j -f '%Y-%m-%d %H:%M:%S' "$VALIDATED_TIME" +%s >/dev/null 2>&1; then
            VALIDATED_EPOCH=$(date -j -f '%Y-%m-%d %H:%M:%S' "$VALIDATED_TIME" +%s 2>/dev/null || echo "0")
        else
            VALIDATED_EPOCH=$(date -d "$VALIDATED_TIME" +%s 2>/dev/null || echo "0")
        fi
        AGE_SECONDS=$(( $(date +%s) - VALIDATED_EPOCH ))
        if [ "$AGE_SECONDS" -le "$FULL_WINDOW_SECONDS" ] && [ "$RECORDED_TREE_HASH" = "$CURRENT_TREE_HASH" ]; then
            echo "✅ 已有完整(FULL)驗證記錄（$VALIDATED_TIME，$((AGE_SECONDS / 60)) 分鐘前）、tree-hash 相符 → 允許 push ✅"
            exit 0
        fi
    fi
fi

# =============================================
# 3. 執行完整測試程序：make validate-release（act + schema 漂移 + e2e）
# =============================================
echo ""
echo "🔴 開始完整測試程序：make validate-release（act backend+frontend + schema 漂移 + e2e）"
echo "   ⏱️  完整守門約 30-45 分鐘——這是「上 GIT」前一次到位的代價；請 commit 勤、push 少（批次攤平）。"
echo "   commit：$CURRENT_COMMIT"
echo "   tree ：$(printf '%.16s' "$CURRENT_TREE_HASH")..."
echo "=========================================="

if make validate-release; then
    record_full_and_allow
    echo ""
    echo "=========================================="
    echo "✅ 完整測試程序通過！允許 push ✅"
    echo "🌳 Tree hash: $(printf '%.16s' "$CURRENT_TREE_HASH")..."
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "🔴 完整測試程序失敗！禁止 push！"
    echo "=========================================="
    echo "📋 依失敗項目修復後重試；可單獨重跑定位："
    echo "   make validate-all      # act backend+frontend"
    echo "   make validate-schema   # entity↔migration 漂移"
    echo "   make validate-e2e      # Playwright e2e + 乾淨 DB"
    echo "🔴 禁止使用 --no-verify！會導致未完整驗證程式碼上庫。"
    echo ""
    exit 1
fi
