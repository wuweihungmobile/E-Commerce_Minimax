#!/usr/bin/env sh
# =============================================
# AISDLC v0.09: Pre-Push Hook（輕量守門 v6 — 本地快、雲端跑重活）
# 目的：push 前跑「輕量守門」= make validate-push（backend-unit + schema 漂移 + frontend，
#       約 8-12 分鐘），完整的 backend-integration（41 支 failsafe 整合測試，~20-25 分）
#       與 E2E 交給雲端 push 觸發（act-compat.yml on: push branches: [main]）執行。
#
# 🔴 v6 變更（2026-07-04，解決「push 前完整測試程序 25-35 分鐘」過慢問題）：
#   - v5（2026-06-30）曾讓 pre-push 跑全套 make validate-release（含 backend-integration + e2e，
#     ~30-45 分），原因是當時雲端 push trigger 已關閉（避免 private repo Actions 帳單），
#     完整驗證只能全部壓在本地 4 核/8GB 機器上。
#   - 現況：push 頻率已受控（commit 勤、push 以 Sprint 收尾為單位，非當初帳單出事那種高頻
#     失敗重推），加上本地輕量守門已先把關，重新打開雲端 push trigger 的帳單風險可控。
#   - 於是把「重活」（backend-integration + frontend build）交還雲端，本地只留快速把關。
#   - 涵蓋範圍不變：backend-unit 仍是完整 surefire 單元測試（無篩選），validate-schema 仍是
#     完整 entity↔migration 漂移檢查；只是 41 支 failsafe 整合測試不再本地跑，改雲端跑。
#   - 純文件/設定（無 backend/frontend 程式碼變動）→ 略過（輕量守門對其無意義）。
#
# 分層：
#   pre-commit            ：lint + compile + 核心測試（快速，每次 commit）
#   pre-push（本檔）       ：輕量守門 = make validate-push（~8-12 分，每次 push）
#   雲端（push 觸發）      ：backend-integration + frontend（act-compat.yml，~25-30 分，非同步）
#
# 跳過方式：git push --no-verify（⚠️ 嚴禁！會導致未經輕量守門的程式碼上庫）
# =============================================

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# 跨平台 sha256：優先 sha256sum（Linux），fallback shasum -a 256（macOS）
calc_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
    else
        shasum -a 256 | cut -d' ' -f1
    fi
}

# PUSHGATE 記錄有效期：30 分（tree-hash 相符為主、時間為輔；避免手動跑過 validate-push 後又重跑一次）
PUSHGATE_WINDOW_SECONDS=1800

echo "=========================================="
echo "🔒 Pre-Push 輕量守門（backend-unit + schema 漂移 + frontend；完整整合測試交雲端）"
echo "=========================================="

# 🔴 檢查 .ci-validation-data 是否被錯誤地 commit 到 Git
if git ls-files --error-unmatch .ci-validation-data >/dev/null 2>&1; then
    echo ""
    echo "🔴 ERROR: .ci-validation-data 已被 commit 到 Git！"
    echo "   這個目錄是本地驗證記錄，不應該被 commit（應在 .gitignore 中）。"
    echo "   修復："
    echo "   git rm -r --cached .ci-validation-data"
    echo "   git commit -m 'chore: remove .ci-validation-data from git tracking'"
    echo ""
    exit 1
fi

CURRENT_COMMIT=$(git rev-parse HEAD)
CI_DATA_DIR="$ROOT_DIR/.ci-validation-data"
CI_RECORD="$CI_DATA_DIR/commits"
CURRENT_TREE_HASH=$(git ls-tree -r HEAD 2>/dev/null | calc_sha256)
if [ -z "$CURRENT_TREE_HASH" ]; then
    CURRENT_TREE_HASH="empty"
fi

# 寫入 PUSHGATE 驗證記錄並放行（5 欄位：COMMIT|TIME|TREE|SUCCESS|PUSHGATE）
record_pushgate_and_allow() {
    VALIDATED_TIME=$(date '+%Y-%m-%d %H:%M:%S')
    mkdir -p "$CI_DATA_DIR"
    if [ -f "$CI_RECORD" ]; then
        TMPRECORD=$(mktemp)
        grep -v "^$CURRENT_COMMIT|" "$CI_RECORD" > "$TMPRECORD" 2>/dev/null || true
        mv "$TMPRECORD" "$CI_RECORD"
    fi
    echo "$CURRENT_COMMIT|$VALIDATED_TIME|$CURRENT_TREE_HASH|SUCCESS|PUSHGATE" >> "$CI_RECORD"
}

# =============================================
# 1. 變動範圍：純文件/設定（無 backend/frontend 程式碼）→ 略過輕量守門
# =============================================
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
REMOTE_HEAD=$(git rev-parse "origin/$CURRENT_BRANCH" 2>/dev/null || echo "")
if [ -n "$REMOTE_HEAD" ]; then
    CHANGED_FILES=$(git diff --name-only "$REMOTE_HEAD..HEAD" 2>/dev/null || echo "")
else
    CHANGED_FILES=""
fi
HAS_BE=$(echo "$CHANGED_FILES" | grep -E '^backend/' | head -1 || true)
HAS_FE=$(echo "$CHANGED_FILES" | grep -E '^frontend/' | head -1 || true)

if [ -n "$REMOTE_HEAD" ] && [ -z "$HAS_BE" ] && [ -z "$HAS_FE" ]; then
    echo "ℹ️  本次推送無 backend/frontend 程式碼變動（純文件/設定），輕量守門對其無意義 → 允許 push ✅"
    exit 0
fi

# =============================================
# 2. 已有有效 PUSHGATE 驗證記錄（tree-hash 相符 + 30 分內）→ 直接放行
#    涵蓋情境：剛手動跑過 make validate-push（或 validate-release），或前次 push 失敗後重試。
# =============================================
if [ -f "$CI_RECORD" ]; then
    VALIDATED=$(grep "^$CURRENT_COMMIT|" "$CI_RECORD" 2>/dev/null | grep -E '\|(PUSHGATE|FULL)$' | tail -1)
    if [ -n "$VALIDATED" ]; then
        VALIDATED_TIME=$(echo "$VALIDATED" | cut -d'|' -f2)
        RECORDED_TREE_HASH=$(echo "$VALIDATED" | cut -d'|' -f3)
        if date -j -f '%Y-%m-%d %H:%M:%S' "$VALIDATED_TIME" +%s >/dev/null 2>&1; then
            VALIDATED_EPOCH=$(date -j -f '%Y-%m-%d %H:%M:%S' "$VALIDATED_TIME" +%s 2>/dev/null || echo "0")
        else
            VALIDATED_EPOCH=$(date -d "$VALIDATED_TIME" +%s 2>/dev/null || echo "0")
        fi
        AGE_SECONDS=$(( $(date +%s) - VALIDATED_EPOCH ))
        if [ "$AGE_SECONDS" -le "$PUSHGATE_WINDOW_SECONDS" ] && [ "$RECORDED_TREE_HASH" = "$CURRENT_TREE_HASH" ]; then
            echo "✅ 已有守門驗證記錄（$VALIDATED_TIME，$((AGE_SECONDS / 60)) 分鐘前）、tree-hash 相符 → 允許 push ✅"
            exit 0
        fi
    fi
fi

# =============================================
# 3. 執行輕量守門：make validate-push（backend-unit + schema 漂移 + frontend）
# =============================================
echo ""
echo "🔴 開始輕量守門：make validate-push（backend-unit + schema 漂移 + frontend）"
echo "   ⏱️  約 8-12 分鐘；完整 backend-integration/E2E 會在 push 後由雲端自動執行。"
echo "   commit：$CURRENT_COMMIT"
echo "   tree ：$(printf '%.16s' "$CURRENT_TREE_HASH")..."
echo "=========================================="

if make validate-push; then
    record_pushgate_and_allow
    echo ""
    echo "=========================================="
    echo "✅ 輕量守門通過！允許 push ✅"
    echo "🌳 Tree hash: $(printf '%.16s' "$CURRENT_TREE_HASH")..."
    echo "☁️  push 後請留意雲端 CI（gh run list / gh run watch）：完整 backend-integration + frontend"
    echo "   會自動執行，若失敗請依 CLAUDE.md 規則先 gh run view <id> --log-failed 找根因再修。"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "🔴 輕量守門失敗！禁止 push！"
    echo "=========================================="
    echo "📋 依失敗項目修復後重試；可單獨重跑定位："
    echo "   make validate-fast     # act backend-unit + frontend"
    echo "   make validate-schema   # entity↔migration 漂移"
    echo "   make validate-release  # 完整測試程序（含 backend-integration + e2e，手動全量確認用）"
    echo "🔴 禁止使用 --no-verify！會導致未經輕量守門的程式碼上庫。"
    echo ""
    exit 1
fi
